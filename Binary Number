class Solution {
    public int search(int[] nums, int target) {
        int start = 0;
        int last = nums.length-1;
        while(last>=start){
            int mid = (start + last)/2;
            if(nums[mid] == target){
                 return mid;
            }
            else if(nums[mid] < target){
                start = mid+1;
            }else{
                last = mid-1;
            }
        }
        return -1;
    }
}
