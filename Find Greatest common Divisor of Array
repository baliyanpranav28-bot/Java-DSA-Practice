class Solution {
    public int findGCD(int[] nums) {
        int largest = nums[0];
        int smallest = nums[0];
        for(int i = 0; i<= nums.length-1; i++){
            if( nums[i] < smallest){
                smallest = nums[i];
            }
            if( nums[i] > largest){
                largest = nums[i];
            }
        }
        return gcd(smallest,largest);
    }
    public int gcd(int smallest, int largest){
        if( largest == 0){
            return smallest;
        }
        return gcd(largest,smallest % largest);
    }
}
